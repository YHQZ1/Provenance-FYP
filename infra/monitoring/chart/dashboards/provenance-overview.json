          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"provenance\", job=\"backend\", route!~\"/api/regulatory/query|/api/trace/chat|/api/documents/upload|/api/compliance/filing/regulatory-review\", route!=\"unmatched\"}[5m]))) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
