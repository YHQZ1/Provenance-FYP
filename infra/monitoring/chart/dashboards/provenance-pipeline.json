      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (service) (rate(downstream_request_duration_seconds_count{namespace=\"provenance\", outcome=\"error\"}[10m])) / sum by (service) (rate(downstream_request_duration_seconds_count{namespace=\"provenance\"}[10m]))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
