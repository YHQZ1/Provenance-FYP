{
  "name": "provenance-api",
  "version": "1.0.0",
  "description": "Backend service for Provenance providing API infrastructure, authentication, and core platform functionality",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "test": "node --test test/**/*.test.js",
    "worker": "cross-env NODE_ENV=production node src/worker.js",
    "worker:dev": "cross-env NODE_ENV=development node src/worker.js"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@sentry/node": "^11.6.0",
    "@supabase/supabase-js": "^2.100.1",
    "axios": "^1.14.0",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
