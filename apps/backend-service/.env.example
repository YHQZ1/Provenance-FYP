# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (database, storage, auth)
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Services. Use Compose hostnames (http://ocr-service:8000) when the backend runs in Docker.
OCR_SERVICE_URL=http://localhost:8000
OCR_TIMEOUT_MS=300000
RAG_SERVICE_URL=http://localhost:8001
RAG_TIMEOUT_MS=180000
# Line items classified in parallel per document. Raise only if Ollama has spare capacity.
RAG_CONCURRENCY=2
REGULATORY_RAG_URL=http://localhost:8002
REGULATORY_RAG_TIMEOUT_MS=180000

# Public links shown with filing sources.
EPR_PORTAL_URL=https://eprplastic.cpcb.gov.in/
EPR_GUIDANCE_MANUAL_URL=https://eprplastic.cpcb.gov.in/assets/pdfs/Guidance_Manual.pdf

# Processing queue and cache. Leave REDIS_URL empty to process in this process with no cache.
REDIS_URL=redis://localhost:6379
# Documents processed at once, and attempts before a document is marked failed.
PROCESSING_CONCURRENCY=2
PROCESSING_ATTEMPTS=3
# false makes this an API-only process; run `npm run worker` alongside it.
RUN_WORKER=true
# Login for the queue dashboard at /admin/queues. It stays off while either is empty.
ADMIN_USER=
ADMIN_PASSWORD=

# Uploads
UPLOAD_TEMP_DIR=./uploads
# true replaces OCR and classification with canned results (UI work without the ML stack)
USE_MOCK_SERVICES=false
